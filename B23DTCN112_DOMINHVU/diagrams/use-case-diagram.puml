@startuml
!include style.iuml
left to right direction
skinparam packageStyle rectangle
actor "Người dùng" as User

rectangle "Client quản lý thuốc theo công dụng – phần cá nhân" {
  usecase "Xem danh sách thuốc,\ncông dụng (từ Server)" as UC0
  usecase "Xóa thuốc" as UC1
  usecase "Xóa công dụng" as UC2
  usecase "Hiển thị kết quả xóa" as UC3
  usecase "Xác nhận trước\nkhi xóa" as UC4
}

User -- UC0
User -- UC1
User -- UC2
User -- UC3
UC1 ..> UC4 : <<include>>
UC2 ..> UC4 : <<include>>
@enduml
